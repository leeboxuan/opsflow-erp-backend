  collectionType     CollectionType?
  status             JobStatus @default(ONGOING)
  notes              String?
  /// Job-level pickup reference (container-style jobs). Prefer over JobItem.pickupReference.
  pickupReference    String?
  /// Job-level description (distinct from LCL item descriptions and Job.notes).
  description        String?   @db.Text
  pickupDate         DateTime?
  pickupAddress1     String
  pickupAddress2     String?
  pickupPostal       String?
  pickupContactName  String?
  pickupContactPhone String?
  deliveryAddress1   String
  deliveryAddress2   String?
  deliveryPostal     String?
  receiverName       String
  receiverPhone      String
  /// Deprecated runtime field: use Trip.assignedDriverUserId/Trip.driverId for execution assignment.
  assignedDriverId   String?
  /// Deprecated runtime field: use Trip.vehicleId/Trip.fleetVehicleId for execution assignment.
  assignedVehicleId  String?
  /// Deprecated runtime field: use Trip.vehicleId/Trip.fleetVehicleId for execution assignment.
  assignedFleetVehicleId String?
  /// Deprecated runtime field: assignment timestamp should come from Trip.assignedAt.
  assignedAt         DateTime?
  /// Deprecated runtime field: execution lifecycle is trip-driven.
  startedAt          DateTime?
  /// Deprecated runtime field: execution lifecycle is trip-driven.
  completedAt        DateTime?
  /// Deprecated runtime field: execution lifecycle is trip-driven.
  deliveredAt        DateTime?
  /// Set when ops explicitly hands this job over to finance invoicing flow.
  invoiceReadyAt     DateTime?
  /// Deprecated runtime field: derive proof/recipient data from TripDocument artifacts.
  podRecipientName   String?
  cancelledReason    String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  /// Deprecated runtime field: use DriverLocationLatest as location source of truth.
  lastLat            Float?
  /// Deprecated runtime field: use DriverLocationLatest as location source of truth.
  lastLng            Float?
  /// Deprecated runtime field: use DriverLocationLatest as location source of truth.
  lastLocationAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdByUserId String?
  /// IMPORT: Singapore port master code (master_singapore_ports.code)
  pickupPortCode  String?
  portTerminalCode String?
  portName         String?
  psaStorageRentLastDay DateTime?
  vesselName       String?
  vesselEta        DateTime?
  /// Optional shipping refs for all job types (IMPORT/EXPORT/COLLECTION/LCL).
  carrierName      String?
  voyage           String?
  shipper          String?
  portnetReady     Boolean  @default(false)
  permitReady      Boolean  @default(false)
  returningDepotCode   String?
  returnLastDay        DateTime?
  /// EXPORT: origin depot and destination port codes (master data)
  exportOriginDepotCode String?
  exportPortCode        String?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies @relation("JobCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: Restrict)
  assignedDriver  User?              @relation("JobAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedFleetVehicle FleetVehicle? @relation(fields: [assignedFleetVehicleId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("JobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents       JobDocument[]
  items           JobItem[]
  trips           Trip[]
  charges         JobCharge[]

  @@unique([tenantId, internalRef])
  @@index([tenantId, customerCompanyId])
  @@index([tenantId, status])
  @@index([tenantId, pickupDate])
  @@index([tenantId, assignedDriverId])
  @@index([tenantId, assignedFleetVehicleId])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, updatedAt])
  @@map("jobs")
}

