  inventoryUnit    inventory_units   @relation(fields: [inventoryUnitId], references: [id], onDelete: Restrict)

  @@unique([tenantId, warehouseJobId, inventoryUnitId])
  @@index([tenantId, warehouseJobId])
  @@index([tenantId, warehouseJobLineId])
  @@index([tenantId, inventoryUnitId])
