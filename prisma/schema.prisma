model inventory_batches {
  id              String @id @default(cuid())
  tenantId        String
  containerNumber String

  // ✅ Stock-In v2 fields
  batchDescription  String?
  customerCompanyId String?
  customerContactId String?

  // Legacy fields (kept for backward compatibility)
  customerName String?
  customerRef  String?

  receivedAt DateTime?
  notes      String?
  status     InventoryBatchStatus @default(Draft)
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies? @relation("InventoryBatchCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: SetNull)
  customerContact customer_contacts?  @relation("InventoryBatchCustomerContact", fields: [customerContactId], references: [id], onDelete: SetNull)

  inventory_batch_items inventory_batch_items[]
  inventory_units       inventory_units[]
  transport_order_items transport_order_items[]
  warehouseJobs         WarehouseJob[]
  warehouseJobLines     WarehouseJobLine[]

  @@unique([tenantId, containerNumber])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, customerCompanyId])
  @@index([tenantId, customerContactId])
  @@map("inventory_batches")
}

model inventory_batch_items {
  id              String            @id @default(cuid())
  tenantId        String
  batchId         String
  inventoryItemId String
  qty             Int
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  tenant          Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  batch           inventory_batches @relation(fields: [batchId], references: [id], onDelete: Cascade)
  inventory_item  inventory_items   @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@unique([batchId, inventoryItemId])
  @@index([tenantId, batchId])
  @@map("inventory_batch_items")
}

model inventory_units {
  id               String                       @id @default(cuid())
  tenantId         String
  inventoryItemId  String
  batchId          String
  unitSku          String
  status           InventoryUnitStatus          @default(Available)
  transportOrderId String?
  tripId           String?
  stopId           String?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt
  tenant           Tenant                       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory_item   inventory_items              @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  batch            inventory_batches            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  transport_order  TransportOrder?              @relation(fields: [transportOrderId], references: [id], onDelete: SetNull)
  trip             Trip?                        @relation(fields: [tripId], references: [id], onDelete: SetNull)
  stop             Stop?                        @relation(fields: [stopId], references: [id], onDelete: SetNull)
  order_item_links transport_order_item_units[]
  warehouseJobUnits WarehouseJobUnit[]

  @@unique([tenantId, unitSku])
  @@index([tenantId, inventoryItemId, status])
  @@index([tenantId, batchId])
  @@index([tenantId, transportOrderId])
  @@index([tenantId, status])
  @@map("inventory_units")
}

model WarehouseJob {
  id                String               @id @default(cuid())
  tenantId          String
  internalRef       String
  type              WarehouseJobType
  status            WarehouseJobStatus   @default(DRAFT)
  priority          WarehouseJobPriority @default(NORMAL)
  title             String?
  description       String?
  notes             String?
  customerCompanyId String?
  inventoryBatchId  String?
  assignedToUserId  String?
  /// CS / transport staff person in charge (office).
  csInChargeUserId  String?
  createdByUserId   String?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  cancelledReason   String?
  containerNumber   String?
  sealNumber        String?
  warehouseNotes    String?
  customerReference String?
  orderReference  String?
  customerInitial String?
  creatorInitial  String?
  customerReferenceSeq Int?
  receivingVessel String?
  placeOfDelivery String?
  destinationCountry String? @default("Singapore")
  arrivalDate     DateTime?
  departureDate   DateTime?
  generateDeliveryOrder Boolean @default(false)
  deliveryOrderGeneratedAt DateTime?
  /// Points to WarehouseJobDocument.id (no FK to avoid circular relation complexity).
  deliveryOrderDocumentId String?
  /// Opaque cross-domain pointer (e.g. TRANSPORT_ORDER + id) — no FK to transport tables.
  externalRefType   String?
  externalRefId     String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies? @relation("WarehouseJobCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: SetNull)
  inventoryBatch  inventory_batches?  @relation(fields: [inventoryBatchId], references: [id], onDelete: SetNull)
  assignedToUser  User?               @relation("WarehouseJobAssignedTo", fields: [assignedToUserId], references: [id], onDelete: SetNull)
  csInChargeUser  User?               @relation("WarehouseJobCsInCharge", fields: [csInChargeUserId], references: [id], onDelete: SetNull)
  createdByUser   User?               @relation("WarehouseJobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)

  lines     WarehouseJobLine[]
  units     WarehouseJobUnit[]
  events    WarehouseJobEvent[]
  documents WarehouseJobDocument[]
  cargoLines WarehouseJobCargoLine[]
  containers WarehouseJobContainer[]

  @@unique([tenantId, internalRef])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, priority])
  @@index([tenantId, customerCompanyId])
  @@index([tenantId, inventoryBatchId])
  @@index([tenantId, assignedToUserId])
  @@index([tenantId, csInChargeUserId])
  @@index([tenantId, createdAt])
  @@index([tenantId, externalRefType, externalRefId])
  @@map("warehouse_jobs")
}

model WarehouseJobLine {
  id               String   @id @default(cuid())
  tenantId         String
  warehouseJobId   String
  inventoryItemId  String?
  inventoryBatchId String?
  description      String?
  requestedQty     Int      @default(0)
  completedQty     Int      @default(0)
  sortOrder        Int      @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  warehouseJob   WarehouseJob       @relation(fields: [warehouseJobId], references: [id], onDelete: Cascade)
  inventoryItem  inventory_items?   @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryBatch inventory_batches? @relation(fields: [inventoryBatchId], references: [id], onDelete: Restrict)

  units WarehouseJobUnit[]

  @@index([tenantId, warehouseJobId])
  @@index([tenantId, inventoryItemId])
  @@index([tenantId, inventoryBatchId])
  @@index([warehouseJobId, sortOrder])
  @@map("warehouse_job_lines")
}

model WarehouseJobUnit {
  id                 String                     @id @default(cuid())
  tenantId           String
  warehouseJobId     String
  warehouseJobLineId String?
  inventoryUnitId    String
  linkStatus         WarehouseJobUnitLinkStatus @default(PLANNED)
