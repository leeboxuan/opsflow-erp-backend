  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@index([tenantId, sourceJobId])
  @@map("invoices")
}

model InvoiceLineItem {
  id        String @id @default(cuid())
  tenantId  String
  invoiceId String

  description    String
  qty            Int
  unitPriceCents Int
  amountCents    Int

  taxCode  String // "SR" | "ZR"
  taxRate  Int // store as integer percent*100? We'll store 900 = 9.00%, 0 = 0
  taxCents Int
  sourceType String? // JOB | QUOTATION_MASTER | MANUAL
  sourceMasterItemId String?
  sourceTripId String?
  tripDisplayRefSnapshot String?
  requiresManualAmount Boolean @default(false)

  createdAt DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, invoiceId])
  @@map("invoice_line_items")
}

model transport_internal_ref_counters {
  tenantId String
  yyyymm   String
  nextSeq  Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, yyyymm])
  @@index([tenantId])
  @@map("transport_internal_ref_counters")
}

enum NotificationAudience {
  USER
  ROLE
  TENANT
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  DANGER
}

model Notification {
  id           String               @id @default(cuid())
  tenantId     String
  userId       String?
  role         Role?
  audience     NotificationAudience
  type         String
  title        String
  description  String?
  severity     NotificationSeverity @default(INFO)
  entityType   String?
  entityId     String?
  jobId        String?
  tripId       String?
  driverUserId String?
  metadata     Json?
  createdAt    DateTime             @default(now())

  tenant     Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  recipients NotificationRecipient[]

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, role, createdAt])
  @@index([tenantId, type, entityId])
  @@map("notifications")
}

model NotificationRecipient {
  id             String    @id @default(cuid())
  notificationId String
  tenantId       String
  userId         String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@unique([notificationId, userId])
  @@index([tenantId, userId, readAt, createdAt])
  @@index([tenantId, userId, createdAt])
  @@map("notification_recipients")
}

enum PushPlatform {
  ios
  android
  unknown
}

model PushDevice {
  id            String       @id @default(cuid())
  tenantId      String
  userId        String
  platform      PushPlatform @default(unknown)
  expoPushToken String       @unique
  deviceId      String?
  appVersion    String?
  lastSeenAt    DateTime     @default(now())
  disabledAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([disabledAt])
  @@map("push_devices")
}

model Chassis {
  id        String   @id @default(cuid())
  tenantId  String
  chassisNo String
  label     String?
  status    String   @default("ACTIVE")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gpsDevices   GpsDevice[]
  gpsPositions GpsPosition[]

  @@unique([tenantId, chassisNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@map("chassis")
}

model GpsDevice {
  id           String    @id @default(cuid())
  tenantId     String
  chassisId    String?
  vehicleId    String?
  driverId     String?
  terminalId   String    @unique
  imei         String?
  simNumber    String?
  model        String    @default("TK905B-4G")
  protocol     String    @default("JT808")
  isActive     Boolean   @default(true)
  lastSeenAt   DateTime?
  lastLat      Decimal?  @db.Decimal(10, 7)
  lastLng      Decimal?  @db.Decimal(10, 7)
  lastSpeedKph Float?
  lastHeading  Int?
  lastBatteryVoltageMv Int?
  lastBatteryVoltage   Decimal?  @db.Decimal(6, 3)
  lastBatteryPercent   Int?
  lastBatterySeenAt    DateTime?
  lastSignalStrength   Int?
  lastSatelliteCount   Int?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  chassis   Chassis?      @relation(fields: [chassisId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver    drivers?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  positions GpsPosition[]

  @@index([tenantId])
  @@index([tenantId, chassisId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, driverId])
  @@map("gps_devices")
}

model GpsPosition {
  id            String   @id @default(cuid())
  tenantId      String
  gpsDeviceId   String
  chassisId     String?
  vehicleId     String?
  driverId      String?
  lat           Decimal  @db.Decimal(10, 7)
  lng           Decimal  @db.Decimal(10, 7)
  speedKph      Float?
  heading       Int?
  altitude      Float?
  batteryVoltageMv Int?
  batteryVoltage   Decimal? @db.Decimal(6, 3)
  batteryPercent   Int?
  signalStrength   Int?
  satelliteCount   Int?
  recordedAt    DateTime
  receivedAt    DateTime @default(now())
  rawProtocol   String?
  rawMessageId  String?
  rawPayload    Json?
  createdAt     DateTime @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  gpsDevice GpsDevice @relation(fields: [gpsDeviceId], references: [id], onDelete: Cascade)
  chassis   Chassis?  @relation(fields: [chassisId], references: [id], onDelete: SetNull)
  vehicle   Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driver    drivers?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@index([gpsDeviceId, recordedAt])
  @@index([chassisId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([tenantId, chassisId, recordedAt])
  @@index([tenantId, recordedAt])
  @@map("gps_positions")
}

/// Customer-scoped commercial rate template (independent copy; source IDs audit-only).
model CustomerRateTemplate {
  id                          String                     @id @default(cuid())
  tenantId                    String
  customerCompanyId           String
  name                        String
  status                      CustomerRateTemplateStatus @default(DRAFT)
  currency                    String                     @default("SGD")
  effectiveFrom               DateTime?
  effectiveTo                 DateTime?
  notes                       String?
  sourceMasterDatasetId       String?
  sourceMasterDatasetVersionNo Int?
  createdAt                   DateTime                   @default(now())
  createdByUserId             String?
  updatedAt                   DateTime                   @updatedAt
  updatedByUserId             String?

  tenant          Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies       @relation(fields: [customerCompanyId], references: [id], onDelete: Cascade)
  createdBy       User?                    @relation("CustomerRateTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?                    @relation("CustomerRateTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  rows            CustomerRateTemplateRow[]
  quotations      CustomerQuotation[]

  @@index([tenantId, customerCompanyId])
  @@index([tenantId, customerCompanyId, status])
  @@map("customer_rate_templates")
}

model CustomerRateTemplateRow {
  id                     String   @id @default(cuid())
  templateId             String
  tenantId               String
  code                   String
  label                  String
  section                String?
  description            String?
  category               String?
  unit                   String?
  containerSize          String?
  tripMode               String?
  areaScope              String?
  currency               String   @default("SGD")
  rateCents              Int?
  rawRateText            String?
  requiresManualAmount   Boolean  @default(false)
  hasMultipleRates       Boolean  @default(false)
  rateOptionsJson        Json?
  defaultRateOptionIndex Int?
  notes                  String?
  sortOrder              Int?
  isActive               Boolean  @default(true)
  metadataJson           Json?
  sourceMasterRowId      String?
  createdAt              DateTime @default(now())
  createdByUserId        String?
  updatedAt              DateTime @updatedAt
  updatedByUserId        String?

  template CustomerRateTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tenant   Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, templateId])
  @@index([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("customer_rate_template_rows")
}

/// Structured customer quotation (commercial offer). Distinct from CustomerCompanyQuotation PDF archive.
model CustomerQuotation {
  id                           String                            @id @default(cuid())
  tenantId                     String
  customerCompanyId            String
  quotationNo                  String
  title                        String?
  status                       CustomerQuotationStatus           @default(DRAFT)
  currency                     String                            @default("SGD")
  issueDate                    DateTime?
  validFrom                    DateTime?
  validUntil                   DateTime?
  notes                        String?
  sourceTemplateId             String?
  sourceTemplateNameSnapshot   String?
  subtotalCents                Int                               @default(0)
  taxCents                     Int                               @default(0)
  totalCents                   Int                               @default(0)
  issuedAt                     DateTime?
  issuedByUserId               String?
  lockedAt                     DateTime?
  acceptedAt                   DateTime?
  acceptedByUserId             String?
  acceptanceMethod             CustomerQuotationAcceptanceMethod?
  acceptanceEvidenceNote       String?
  acceptanceEvidenceStorageKey String?
  rejectedAt                   DateTime?
  voidedAt                     DateTime?
  expiredAt                    DateTime?
  customerNameSnapshot        String?
  pdfKey                       String?
  pdfGeneratedAt               DateTime?
  createdAt                    DateTime                          @default(now())
  createdByUserId              String?
  updatedAt                    DateTime                          @updatedAt
  updatedByUserId              String?

  tenant          Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies     @relation(fields: [customerCompanyId], references: [id], onDelete: Restrict)
  sourceTemplate  CustomerRateTemplate?  @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  createdBy       User?                  @relation("CustomerQuotationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy       User?                  @relation("CustomerQuotationUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  issuedBy        User?                  @relation("CustomerQuotationIssuedBy", fields: [issuedByUserId], references: [id], onDelete: SetNull)
  acceptedBy      User?                  @relation("CustomerQuotationAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: SetNull)
  lines           CustomerQuotationLine[]

  @@unique([tenantId, quotationNo])
  @@index([tenantId, customerCompanyId])
  @@index([tenantId, customerCompanyId, status])
  @@index([tenantId, status, validUntil])
  @@map("customer_quotations")
}

model CustomerQuotationLine {
  id                   String   @id @default(cuid())
  quotationId          String
  tenantId             String
  sortOrder            Int      @default(0)
  code                 String
  label                String
  description          String?
  unit                 String?
  qty                  Float    @default(1)
  unitPriceCents       Int      @default(0)
  amountCents          Int      @default(0)
  currency             String   @default("SGD")
  taxCode              String   @default("SR")
  taxRate              Int      @default(900)
  taxCents             Int      @default(0)
  requiresManualAmount Boolean  @default(false)
  sourceTemplateRowId  String?
  sourceMasterRowId    String?
  metadataJson         Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  quotation CustomerQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, quotationId])
  @@index([tenantId, code])
  @@map("customer_quotation_lines")
}

model quotation_no_counters {
  tenantId  String
  yyyymm    String
  nextSeq   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, yyyymm])
  @@index([tenantId])
  @@map("quotation_no_counters")
}

enum CustomerRateTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum CustomerQuotationStatus {
  DRAFT
  ISSUED
  ACCEPTED
  REJECTED
  EXPIRED
  VOID
}

enum CustomerQuotationAcceptanceMethod {
  EMAIL
  PORTAL
  PHONE
  SIGNED_DOCUMENT
  OTHER
}
