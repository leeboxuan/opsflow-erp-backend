/// Append-only platform action log. Do not update/delete rows in application code.
model PlatformAuditLog {
  id                   String   @id @default(cuid())
  actorPlatformAdminId String
  actorUserId          String
  targetTenantId       String?
  action               String
  entityType           String?
  entityId             String?
  correlationId        String?
  reason               String?
  /// Redacted metadata only — never store secrets/passwords.
  metadata             Json?
  createdAt            DateTime @default(now())

  actorPlatformAdmin PlatformAdmin @relation(fields: [actorPlatformAdminId], references: [id], onDelete: Restrict)
  actorUser          User          @relation("PlatformAuditActorUser", fields: [actorUserId], references: [id], onDelete: Restrict)
  targetTenant       Tenant?       @relation("PlatformAuditTargetTenant", fields: [targetTenantId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorPlatformAdminId, createdAt])
  @@index([targetTenantId, createdAt])
  @@index([action, createdAt])
  @@map("platform_audit_logs")
}

