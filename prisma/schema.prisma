generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                           String                            @id @default(cuid())
  name                         String
  slug                         String                            @unique
  timezone                     String?
  /// Lifecycle: SETUP (config), ACTIVE, SUSPENDED (ordinary users blocked), ARCHIVED
  status                       TenantStatus                      @default(ACTIVE)
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  driver_wallet_entries        driver_wallet_entries[]
  driverWalletTransactions     DriverWalletTransaction[]
  drivers                      drivers[]
  driverLocationLatest         DriverLocationLatest[]
  eventLogs                    EventLog[]
  inventory_items              inventory_items[]
  inventory_batches            inventory_batches[]
  inventory_batch_items        inventory_batch_items[]
  inventory_units              inventory_units[]
  podPhotoDocuments            PodPhotoDocument[]
  pods                         Pod[]
  stops                        Stop[]
  memberships                  TenantMembership[]
  transportOrders              TransportOrder[]
  transport_order_items        transport_order_items[]
  trips                        Trip[]
  vehicles                     Vehicle[]
  fleetVehicles                FleetVehicle[]
  transport_order_item_units   transport_order_item_units[]
  customer_companies           customer_companies[]
  Invoice                      Invoice[]
  InvoiceLineItem              InvoiceLineItem[]
  transportInternalRefCounters transport_internal_ref_counters[]
  jobs                         Job[]
  jobDocuments                 JobDocument[]
  jobInternalRefCounters       job_internal_ref_counters[]
  auditLogs                    AuditLog[]
  JobItem                      JobItem[]
  customerCompanyQuotations    CustomerCompanyQuotation[]
  customerCompanyDocuments     CustomerCompanyDocument[]
  customerQuotationRateLines   CustomerQuotationRateLine[]
  customerRateMasterLines      CustomerRateMasterLine[]
  customerRateTemplates        CustomerRateTemplate[]
  customerRateTemplateRows     CustomerRateTemplateRow[]
  customerQuotations           CustomerQuotation[]
  customerQuotationLines       CustomerQuotationLine[]
  quotationNoCounters          quotation_no_counters[]
  masterFiles                  MasterFile[]
  customerQuotationItems       CustomerQuotationItem[]
  tenantQuotationItems         TenantQuotationItem[]
  masterRateDatasets           MasterRateDataset[]
  masterRateDatasetRows        MasterRateDatasetRow[]
  driverPayoutItems            DriverPayoutItem[]
  dhcReferenceItems            DhcReferenceItem[]
  jobCharges                   JobCharge[]
  depotHandlingReferences      DepotHandlingReference[]
  driverTripRateMasters        DriverTripRateMaster[]
  tripDocuments                TripDocument[]
  tripPayoutLines              TripPayoutLine[]
  tripDocumentRequirements     TripDocumentRequirement[]
  notifications                Notification[]
  pushDevices                  PushDevice[]
  chassis                      Chassis[]
  gpsDevices                   GpsDevice[]
  gpsPositions                 GpsPosition[]
  warehouseJobs                WarehouseJob[]
  warehouseJobLines            WarehouseJobLine[]
  warehouseJobUnits            WarehouseJobUnit[]
  warehouseJobEvents           WarehouseJobEvent[]
  warehouseJobInternalRefCounters warehouse_job_internal_ref_counters[]
  warehouseJobCustomerRefCounters warehouse_job_customer_ref_counters[]
  warehouseJobDocuments        WarehouseJobDocument[]
  warehouseJobCargoLines       WarehouseJobCargoLine[]
  warehouseJobContainers       WarehouseJobContainer[]
  tripJobItems                 TripJobItem[]
  moduleEntitlements           TenantModuleEntitlement[]
  platformAuditLogsAsTarget    PlatformAuditLog[]                @relation("PlatformAuditTargetTenant")

  @@map("tenants")
}

model User {
  id         String  @id @default(cuid())
  /// Supabase Auth user id (auth.users.id, UUID). Links JWT sub to this row; not the same as id (cuid).
  authUserId String? @unique
  email      String  @unique
  /// Optional login username (warehouse mobile). Uniqueness enforced per tenant in app logic.
  username   String?
  name       String?
  displayName String?
  phone      String?
  avatarKey  String?
  avatarUrl  String?
  avatarUpdatedAt DateTime?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  /// Application-level role for this user (e.g. 'USER', 'SUPERADMIN').
  /// SUPERADMIN is NOT a tenant Role — platform authority is PlatformAdmin.
  role        UserRole           @default(USER)
  drivers     drivers[]
  profiles    profiles?
  memberships TenantMembership[]
  platformAdmin PlatformAdmin?
  platformAdminsCreated PlatformAdmin[] @relation("PlatformAdminCreatedBy")
  platformAuditLogsAsActor PlatformAuditLog[] @relation("PlatformAuditActorUser")

  customerCompanyId String?
  customerContactId String?

  customerCompany  customer_companies? @relation("UserCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: SetNull)
  customerContact  customer_contacts?  @relation("UserCustomerContact", fields: [customerContactId], references: [id], onDelete: SetNull)
  jobsAssigned     Job[]               @relation("JobAssignedDriver")
  vehiclesAssigned Vehicle[]           @relation("VehicleDriver")
  fleetVehiclesAssigned FleetVehicle[] @relation("FleetVehicleDriver")
  jobsCreated      Job[]               @relation("JobCreatedBy")
  quotationsUploaded CustomerCompanyQuotation[] @relation("QuotationUploadedBy")
  customerCompanyDocumentsUploaded CustomerCompanyDocument[] @relation("CustomerCompanyDocumentUploadedBy")
  customerCompanyDocumentsGenerated CustomerCompanyDocument[] @relation("CustomerCompanyDocumentGeneratedBy")
  jobChargesSelected JobCharge[]       @relation("JobChargeSelectedBy")
  masterFilesUploaded MasterFile[]      @relation("MasterFileUploadedBy")
  jobDocumentsUploaded JobDocument[]   @relation("JobDocumentUploadedBy")
  tripDocumentsUploaded TripDocument[] @relation("TripDocumentUploadedBy")
  warehouseJobsAssignedTo WarehouseJob[]      @relation("WarehouseJobAssignedTo")
  warehouseJobsCsInCharge WarehouseJob[]      @relation("WarehouseJobCsInCharge")
  warehouseJobsCreated    WarehouseJob[]      @relation("WarehouseJobCreatedBy")
  warehouseJobEventsActed WarehouseJobEvent[] @relation("WarehouseJobEventActor")
  warehouseJobDocumentsUploaded WarehouseJobDocument[] @relation("WarehouseJobDocumentUploadedBy")
  warehouseJobDocumentsReviewed WarehouseJobDocument[] @relation("WarehouseJobDocumentReviewedBy")
  tripJobItemsLinked            TripJobItem[]          @relation("TripJobItemLinkedBy")

  customerRateTemplatesCreated  CustomerRateTemplate[] @relation("CustomerRateTemplateCreatedBy")
  customerRateTemplatesUpdated  CustomerRateTemplate[] @relation("CustomerRateTemplateUpdatedBy")
  customerQuotationsCreated     CustomerQuotation[]    @relation("CustomerQuotationCreatedBy")
  customerQuotationsUpdated     CustomerQuotation[]    @relation("CustomerQuotationUpdatedBy")
  customerQuotationsIssued      CustomerQuotation[]    @relation("CustomerQuotationIssuedBy")
  customerQuotationsAccepted    CustomerQuotation[]    @relation("CustomerQuotationAcceptedBy")

  @@index([customerCompanyId])
  @@index([customerContactId])
  @@index([email])
  @@index([authUserId])
  @@index([username])
  @@map("users")
}

model customer_companies {
  id       String @id @default(cuid())
  tenantId String

  // Core identity
  name           String
  normalizedName String

  // Company contact
  email String?
  phone String?

  // Address
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  country      String? @default("SG")

  // Billing
  billingSameAsAddress Boolean @default(false)
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingPostalCode    String?
  billingCountry       String? @default("SG")

  // PIC
  picName   String?
  picMobile String?
  picEmail  String?

  // Helpful extras
  uen      String?
  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts        customer_contacts[]
  batches         inventory_batches[] @relation("InventoryBatchCustomerCompany")
  users           User[]              @relation("UserCustomerCompany")
  transportOrders TransportOrder[]    @relation("TransportOrderCustomerCompany")
  jobs            Job[]               @relation("JobCustomerCompany")
  warehouseJobs   WarehouseJob[]      @relation("WarehouseJobCustomerCompany")
  quotations      CustomerCompanyQuotation[]
  documents       CustomerCompanyDocument[]
  rateMasterLines CustomerRateMasterLine[]
  rateTemplates   CustomerRateTemplate[]
  customerQuotations CustomerQuotation[]
  masterFiles     MasterFile[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("customer_companies")
}

model customer_contacts {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  email           String
  normalizedEmail String
  mobile          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company customer_companies  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches inventory_batches[] @relation("InventoryBatchCustomerContact")
  users   User[]              @relation("UserCustomerContact")

  @@unique([companyId, normalizedEmail])
  @@index([companyId])
  @@map("customer_contacts")
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  status    MembershipStatus @default(Active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_memberships")
}

model TransportOrder {
  id                    String              @id @default(cuid())
  tenantId              String
  customerRef           String
  status                OrderStatus         @default(Open)
  pickupWindowStart     DateTime?
  pickupWindowEnd       DateTime?
  deliveryWindowStart   DateTime?
  deliveryWindowEnd     DateTime?
  notes                 String?
  customerContactNumber String?
  customerCompanyId     String?
  customerCompany       customer_companies? @relation("TransportOrderCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  priceCents     Int?
  currency       String?   @default("SGD")
  customerName   String?
  doDocumentUrl  String?
  doSignatureUrl String?
  doSignedAt     DateTime?
  doSignerName   String?
  doStatus       DoStatus  @default(PENDING)
  doVersion      Int       @default(1)
  // Client's reference (what they give you)
  orderRef       String

  // Internal OpsFlow reference (DB-YYYY-MM-DD-XXX)
  internalRef                String?
  driver_wallet_transactions DriverWalletTransaction[]
  stops                      Stop[]                    @relation("OrderStops")
  transport_order_items      transport_order_items[]
  inventory_units            inventory_units[]
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId                  String?
  invoice                    Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, orderRef])
  @@unique([tenantId, internalRef])
  @@index([tenantId, customerCompanyId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, invoiceId])
  @@map("transport_orders")
}

model Trip {
  id                   String                    @id @default(cuid())
  tenantId             String
  status               TripStatus                @default(DRAFT)
  pendingState         TripPendingState          @default(NONE)
  plannedStartAt       DateTime?
  plannedEndAt         DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  createdByUserId      String?
  publishedAt          DateTime?
  publishedByUserId    String?
  assignedAt           DateTime?
  assignedByUserId     String?
  updatedByUserId      String?
  closedAt             DateTime?
  startedAt            DateTime?
  acceptedTrailerNo    String?
  acceptedVehicleNo    String?
  assignedDriverUserId String?
  driverId             String?
  routeVersion         Int                       @default(1)
  vehicleId            String?
  fleetVehicleId       String?
  /// When set, this trip belongs to an OpsFlow job (multi-leg). Transport-order trips keep jobId null.
  jobId                String?
  /// Sequence within the job (1-based). Null for legacy transport-only trips.
  jobSequence          Int?
  tripSequence         Int?
  displayTitle         String?
  jobTripTemplate      JobTripTemplate?
  title                String?
  startedByDriverUserId   String?
  completedByDriverUserId String?
  /// Cached summary only. Source of truth is TripPayoutLine.
  driverEarningCents      Int?
  earningRateMasterId     String?
  payoutItemId            String?
  earningLabelSnapshot    String?
  trailerNumber           String?
  trailerLastLocationCode String?
  /// Trip-specific ops/driver instructions (distinct from job-level notes).
  notes                   String?                   @db.Text
  /// Driver-owned operational remarks (distinct from Job.description / Job.notes).
  driverRemarks           String?                   @db.Text
  tripPICName             String?
  tripPICContact          String?
  containerNumber         String?
  carrier                 String?
  shipper                 String?
  vessel                  String?
  trailerParkingLat       Float?
  trailerParkingLng       Float?
  trailerParkedAt         DateTime?
  /// e.g. { "requireJobDoSigned": true, "requiredTripUploadTypes": ["OFFLOADING"] }
  completionRuleJson      Json?
  originLocationId        String?
  originLabel             String?
  originAddressLine1      String?
  originAddressLine2      String?
  originPostalCode        String?
  originCountry           String?
  originLat               Float?
  originLng               Float?
  originPlaceId           String?
  destinationLocationId   String?
  destinationLabel        String?
  destinationAddressLine1 String?
  destinationAddressLine2 String?
  destinationPostalCode   String?
  destinationCountry      String?
  destinationLat          Float?
  destinationLng          Float?
  destinationPlaceId      String?
  walletTransactions   DriverWalletTransaction[]
  stops                Stop[]
  inventory_units      inventory_units[]
  drivers              drivers?                  @relation(fields: [driverId], references: [id])
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles             Vehicle?                  @relation(fields: [vehicleId], references: [id])
  fleetVehicle         FleetVehicle?             @relation(fields: [fleetVehicleId], references: [id])
  job                  Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  earningRateMaster    DriverTripRateMaster?     @relation(fields: [earningRateMasterId], references: [id], onDelete: SetNull)
  payoutItem           DriverPayoutItem?         @relation(fields: [payoutItemId], references: [id], onDelete: SetNull)
  documents            TripDocument[]
  payoutLines          TripPayoutLine[]
  documentRequirements TripDocumentRequirement[]
  /// Canonical M:N cargo linkage. Trip.containerNumber is legacy/display cache only.
  tripJobItems         TripJobItem[]

  @@index([tenantId, status])
  @@index([tenantId, plannedStartAt])
  @@index([tenantId, assignedDriverUserId])
  @@index([tenantId, assignedDriverUserId, status, plannedStartAt])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, fleetVehicleId])
  @@index([tenantId, payoutItemId])
  @@index([tenantId, jobId])
  @@index([tenantId, jobId, jobSequence])
  @@map("trips")
}

model MasterLogisticsLocation {
  id           String                @id @default(cuid())
  code         String
  name         String
  label        String?
  type         LogisticsLocationType
  addressLine1 String
  addressLine2 String?
  postalCode   String?
  country      String                @default("SG")
  lat          Float?
  lng          Float?
  placeId      String?
  isActive     Boolean               @default(true)
  sortOrder    Int                   @default(0)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([code])
  @@unique([type, code])
  @@index([type, isActive])
  @@map("master_logistics_locations")
}

model MasterFile {
  id               String            @id @default(cuid())
  tenantId         String
  customerCompanyId String?
  type             MasterFileType
  fileName         String
  fileUrl          String
  uploadedByUserId String?
  uploadedAt       DateTime          @default(now())
  effectiveDate    DateTime?
  status           MasterFileStatus  @default(PARSED)
  parseSummaryJson Json?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany        customer_companies?     @relation(fields: [customerCompanyId], references: [id], onDelete: SetNull)
  uploadedBy             User?                   @relation("MasterFileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  customerQuotationItems CustomerQuotationItem[]
  driverPayoutItems      DriverPayoutItem[]
  dhcReferenceItems      DhcReferenceItem[]

  @@index([tenantId, customerCompanyId, type, isActive])
  @@index([tenantId, type, uploadedAt])
  @@map("master_files")
}

model CustomerQuotationItem {
  id           String   @id @default(cuid())
  tenantId     String
  masterFileId String
  section      String?
  code         String
  label        String
  description  String?
  category     String?
  containerSize String?
  tripMode     String?
  areaScope    String?
  unit         String?
  rateCents    Int?
  requiresManualAmount Boolean @default(false)
  rawRateText  String?
  notes        String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterFile MasterFile @relation(fields: [masterFileId], references: [id], onDelete: Cascade)

  @@index([tenantId, masterFileId])
  @@index([tenantId, active, code])
  @@map("customer_quotation_items")
}

model TenantQuotationItem {
  id                   String   @id @default(cuid())
  tenantId             String
  section              String?
  code                 String
  label                String
  description          String?
  category             String?
  containerSize        String?
  tripMode             String?
  areaScope            String?
  unit                 String?
  rateCents            Int?
  requiresManualAmount Boolean  @default(false)
  rawRateText          String?
  notes                String?
  sortOrder            Int      @default(0)
  active               Boolean  @default(true)
  sourceType           String   @default("EXCEL_IMPORT")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active, sortOrder])
  @@index([tenantId, code])
  @@map("tenant_quotation_items")
}

model MasterRateDataset {
  id               String                @id @default(cuid())
  tenantId         String
  type             MasterRateDatasetType
  versionNo        Int
  status           MasterRateDatasetStatus @default(DRAFT)
  createdAt        DateTime              @default(now())
  createdByUserId  String?
  updatedAt        DateTime              @updatedAt
  updatedByUserId  String?
  importedAt       DateTime?
  importedByUserId String?
  sourceFileName   String?
  activatedAt      DateTime?
  activatedByUserId String?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rows   MasterRateDatasetRow[]

  @@index([tenantId, type, status])
  @@unique([tenantId, type, versionNo])
  @@map("master_rate_datasets")
}

model MasterRateDatasetRow {
  id                     String   @id @default(cuid())
  datasetId              String
  tenantId               String
  code                   String
  label                  String
  section                String?
  description            String?
  category               String?
  unit                   String?
  containerSize          String?
  tripMode               String?
  areaScope              String?
  currency               String   @default("SGD")
  rateCents              Int?
  rawRateText            String?
  requiresManualAmount   Boolean  @default(false)
  hasMultipleRates       Boolean  @default(false)
  rateOptionsJson        Json?
  defaultRateOptionIndex Int?
  notes                  String?
  sortOrder              Int?
  isActive               Boolean  @default(true)
  metadataJson           Json?
  createdAt              DateTime @default(now())
  createdByUserId        String?
  updatedAt              DateTime @updatedAt
  updatedByUserId        String?

  dataset MasterRateDataset @relation(fields: [datasetId], references: [id], onDelete: Cascade)
  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tripPayoutLines TripPayoutLine[]

  @@index([tenantId, datasetId])
  @@index([tenantId, code])
  @@index([tenantId, isActive, sortOrder])
  @@map("master_rate_dataset_rows")
}

model DriverPayoutItem {
  id                      String   @id @default(cuid())
  tenantId                String
  masterFileId            String
  section                 String?
  code                    String
  label                   String
  description             String?
  category                String?
  containerSize           String?
  tripMode                String?
  areaScope               String?
  unit                    String?
  rateCents               Int?
  requiresManualAmount    Boolean @default(false)
  rawRateText             String?
  notes                   String?
  isSelectableForTripEarning Boolean @default(true)
  sortOrder               Int      @default(0)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterFile MasterFile @relation(fields: [masterFileId], references: [id], onDelete: Cascade)
  trips      Trip[]
  tripPayoutLines TripPayoutLine[]

  @@index([tenantId, masterFileId])
  @@index([tenantId, active, code])
  @@map("driver_payout_items")
}

model DhcReferenceItem {
  id           String   @id @default(cuid())
  tenantId     String
  masterFileId String
  section      String?
  code         String
  label        String
  description  String?
  category     String?
  unit         String?
  rateCents    Int?
  yardDepot    String?
  oldRateCents Int?
  newRateCents Int?
  software     String?
  operatorCode String?
  operatorName String?
  effectiveDate DateTime?
  notes        String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterFile MasterFile @relation(fields: [masterFileId], references: [id], onDelete: Cascade)

  @@index([tenantId, masterFileId])
  @@index([tenantId, active, code])
  @@map("dhc_reference_items")
}

model Vehicle {
  id                 String        @id @default(cuid())
  tenantId           String
  plateNo            String
  type               VehicleType
  status             VehicleStatus @default(ACTIVE)
  vehicleDescription String?
  driverId           String?
  roadTaxExpiryDate  DateTime?
  lastServicingDate  DateTime?
  coeExpiryDate      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  trips              Trip[]
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driversDefault     drivers[]
  driver             User?         @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  gpsDevices         GpsDevice[]
  gpsPositions       GpsPosition[]

  @@unique([tenantId, plateNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, driverId])
  @@map("vehicles")
}

model FleetVehicle {
  id                 String        @id @default(cuid())
  tenantId           String
  plateNo            String
  type               VehicleType
  status             VehicleStatus @default(ACTIVE)
  vehicleDescription String?
  driverId           String?
  roadTaxExpiryDate  DateTime?
  lastServicingDate  DateTime?
  coeExpiryDate      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver         User?    @relation("FleetVehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driversDefault drivers[]
  jobsAssigned   Job[]
  trips          Trip[]

  @@unique([tenantId, plateNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, driverId])
  @@map("fleet_vehicles")
}

model Stop {
  id                         String                    @id @default(cuid())
  tenantId                   String
  tripId                     String?
  sequence                   Int?
  type                       StopType
  addressLine1               String
  addressLine2               String?
  city                       String
  postalCode                 String
  country                    String
  plannedAt                  DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  transportOrderId           String?
  completedAt                DateTime?
  startedAt                  DateTime?
  status                     StopStatus                @default(Pending)
  driver_wallet_transactions DriverWalletTransaction[]
  podPhotoDocuments          PodPhotoDocument[]
  pods                       Pod[]
  inventory_units            inventory_units[]
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transportOrder             TransportOrder?           @relation("OrderStops", fields: [transportOrderId], references: [id])
  trip                       Trip?                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat                        Float?
  lng                        Float?
  placeId                    String?
  geocodedAt                 DateTime?

  @@index([tenantId, transportOrderId])
  @@index([tenantId, tripId])
  @@map("stops")
}

model Pod {
  id        String    @id @default(cuid())
  tenantId  String
  stopId    String
  status    PodStatus @default(Pending)
  signedBy  String?
