generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id                           String                            @id @default(cuid())
  name                         String
  slug                         String                            @unique
  createdAt                    DateTime                          @default(now())
  updatedAt                    DateTime                          @updatedAt
  driver_wallet_entries        driver_wallet_entries[]
  driverWalletTransactions     DriverWalletTransaction[]
  drivers                      drivers[]
  driverLocationLatest         DriverLocationLatest[]
  eventLogs                    EventLog[]
  inventory_items              inventory_items[]
  inventory_batches            inventory_batches[]
  inventory_batch_items        inventory_batch_items[]
  inventory_units              inventory_units[]
  podPhotoDocuments            PodPhotoDocument[]
  pods                         Pod[]
  stops                        Stop[]
  memberships                  TenantMembership[]
  transportOrders              TransportOrder[]
  transport_order_items        transport_order_items[]
  trips                        Trip[]
  vehicles                     Vehicle[]
  fleetVehicles                FleetVehicle[]
  transport_order_item_units   transport_order_item_units[]
  customer_companies           customer_companies[]
  Invoice                      Invoice[]
  InvoiceLineItem              InvoiceLineItem[]
  transportInternalRefCounters transport_internal_ref_counters[]
  jobs                         Job[]
  jobDocuments                 JobDocument[]
  jobInternalRefCounters       job_internal_ref_counters[]
  auditLogs                    AuditLog[]
  JobItem                      JobItem[]
  customerCompanyQuotations    CustomerCompanyQuotation[]
  customerQuotationRateLines   CustomerQuotationRateLine[]
  customerRateMasterLines      CustomerRateMasterLine[]
  masterFiles                  MasterFile[]
  customerQuotationItems       CustomerQuotationItem[]
  driverPayoutItems            DriverPayoutItem[]
  dhcReferenceItems            DhcReferenceItem[]
  jobCharges                   JobCharge[]
  depotHandlingReferences      DepotHandlingReference[]
  driverTripRateMasters        DriverTripRateMaster[]
  tripDocuments                TripDocument[]

  @@map("tenants")
}

model User {
  id         String  @id @default(cuid())
  /// Supabase Auth user id (auth.users.id, UUID). Links JWT sub to this row; not the same as id (cuid).
  authUserId String? @unique
  email      String  @unique
  name       String?
  phone      String?

  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  /// Application-level role for this user (e.g. 'USER', 'SUPERADMIN')
  role        UserRole           @default(USER)
  drivers     drivers[]
  profiles    profiles?
  memberships TenantMembership[]

  customerCompanyId String?
  customerContactId String?

  customerCompany  customer_companies? @relation("UserCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: SetNull)
  customerContact  customer_contacts?  @relation("UserCustomerContact", fields: [customerContactId], references: [id], onDelete: SetNull)
  jobsAssigned     Job[]               @relation("JobAssignedDriver")
  vehiclesAssigned Vehicle[]           @relation("VehicleDriver")
  fleetVehiclesAssigned FleetVehicle[] @relation("FleetVehicleDriver")
  jobsCreated      Job[]               @relation("JobCreatedBy")
  quotationsUploaded CustomerCompanyQuotation[] @relation("QuotationUploadedBy")
  jobChargesSelected JobCharge[]       @relation("JobChargeSelectedBy")
  masterFilesUploaded MasterFile[]      @relation("MasterFileUploadedBy")

  @@index([customerCompanyId])
  @@index([customerContactId])
  @@index([email])
  @@index([authUserId])
  @@map("users")
}

model customer_companies {
  id       String @id @default(cuid())
  tenantId String

  // Core identity
  name           String
  normalizedName String

  // Company contact
  email String?
  phone String?

  // Address
  addressLine1 String?
  addressLine2 String?
  postalCode   String?
  country      String? @default("SG")

  // Billing
  billingSameAsAddress Boolean @default(false)
  billingAddressLine1  String?
  billingAddressLine2  String?
  billingPostalCode    String?
  billingCountry       String? @default("SG")

  // PIC
  picName   String?
  picMobile String?
  picEmail  String?

  // Helpful extras
  uen      String?
  notes    String?
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contacts        customer_contacts[]
  batches         inventory_batches[] @relation("InventoryBatchCustomerCompany")
  users           User[]              @relation("UserCustomerCompany")
  transportOrders TransportOrder[]    @relation("TransportOrderCustomerCompany")
  jobs            Job[]               @relation("JobCustomerCompany")
  quotations      CustomerCompanyQuotation[]
  rateMasterLines CustomerRateMasterLine[]
  masterFiles     MasterFile[]

  @@unique([tenantId, normalizedName])
  @@index([tenantId])
  @@index([tenantId, isActive])
  @@map("customer_companies")
}

model customer_contacts {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  email           String
  normalizedEmail String
  mobile          String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  company customer_companies  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  batches inventory_batches[] @relation("InventoryBatchCustomerContact")
  users   User[]              @relation("UserCustomerContact")

  @@unique([companyId, normalizedEmail])
  @@index([companyId])
  @@map("customer_contacts")
}

model TenantMembership {
  id        String           @id @default(cuid())
  tenantId  String
  userId    String
  role      Role
  status    MembershipStatus @default(Active)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, status])
  @@index([userId])
  @@map("tenant_memberships")
}

model TransportOrder {
  id                    String              @id @default(cuid())
  tenantId              String
  customerRef           String
  status                OrderStatus         @default(Open)
  pickupWindowStart     DateTime?
  pickupWindowEnd       DateTime?
  deliveryWindowStart   DateTime?
  deliveryWindowEnd     DateTime?
  notes                 String?
  customerContactNumber String?
  customerCompanyId     String?
  customerCompany       customer_companies? @relation("TransportOrderCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: SetNull)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  priceCents     Int?
  currency       String?   @default("SGD")
  customerName   String?
  doDocumentUrl  String?
  doSignatureUrl String?
  doSignedAt     DateTime?
  doSignerName   String?
  doStatus       DoStatus  @default(PENDING)
  doVersion      Int       @default(1)
  itemsJson      Json?
  // Client's reference (what they give you)
  orderRef       String

  // Internal OpsFlow reference (DB-YYYY-MM-DD-XXX)
  internalRef                String?
  driver_wallet_transactions DriverWalletTransaction[]
  stops                      Stop[]                    @relation("OrderStops")
  transport_order_items      transport_order_items[]
  inventory_units            inventory_units[]
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoiceId                  String?
  invoice                    Invoice?                  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@unique([tenantId, orderRef])
  @@unique([tenantId, internalRef])
  @@index([tenantId, customerCompanyId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, invoiceId])
  @@map("transport_orders")
}

model Trip {
  id                   String                    @id @default(cuid())
  tenantId             String
  status               TripStatus                @default(Draft)
  plannedStartAt       DateTime?
  plannedEndAt         DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  closedAt             DateTime?
  startedAt            DateTime?
  acceptedTrailerNo    String?
  acceptedVehicleNo    String?
  assignedDriverUserId String?
  driverId             String?
  routeVersion         Int                       @default(1)
  vehicleId            String?
  fleetVehicleId       String?
  /// When set, this trip belongs to an OpsFlow job (multi-leg). Transport-order trips keep jobId null.
  jobId                String?
  /// Sequence within the job (1-based). Null for legacy transport-only trips.
  jobSequence          Int?
  jobTripTemplate      JobTripTemplate?
  title                String?
  startedByDriverUserId   String?
  completedByDriverUserId String?
  /// Snapshot: driver earning for this leg once assigned (frozen).
  driverEarningCents      Int?
  earningRateMasterId     String?
  payoutItemId            String?
  earningLabelSnapshot    String?
  trailerNumber           String?
  trailerLastLocationCode String?
  /// e.g. { "requireJobDoSigned": true, "requiredTripUploadTypes": ["OFFLOADING"] }
  completionRuleJson      Json?
  walletTransactions   DriverWalletTransaction[]
  stops                Stop[]
  inventory_units      inventory_units[]
  drivers              drivers?                  @relation(fields: [driverId], references: [id])
  tenant               Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vehicles             Vehicle?                  @relation(fields: [vehicleId], references: [id])
  fleetVehicle         FleetVehicle?             @relation(fields: [fleetVehicleId], references: [id])
  job                  Job?                      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  earningRateMaster    DriverTripRateMaster?     @relation(fields: [earningRateMasterId], references: [id], onDelete: SetNull)
  payoutItem           DriverPayoutItem?         @relation(fields: [payoutItemId], references: [id], onDelete: SetNull)
  documents            TripDocument[]

  @@index([tenantId, status])
  @@index([tenantId, plannedStartAt])
  @@index([tenantId, assignedDriverUserId])
  @@index([tenantId, driverId])
  @@index([tenantId, vehicleId])
  @@index([tenantId, fleetVehicleId])
  @@index([tenantId, payoutItemId])
  @@index([tenantId, jobId])
  @@index([tenantId, jobId, jobSequence])
  @@map("trips")
}

model MasterFile {
  id               String            @id @default(cuid())
  tenantId         String
  customerCompanyId String?
  type             MasterFileType
  fileName         String
  fileUrl          String
  uploadedByUserId String?
  uploadedAt       DateTime          @default(now())
  effectiveDate    DateTime?
  status           MasterFileStatus  @default(PARSED)
  parseSummaryJson Json?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  tenant                 Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany        customer_companies?     @relation(fields: [customerCompanyId], references: [id], onDelete: SetNull)
  uploadedBy             User?                   @relation("MasterFileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  customerQuotationItems CustomerQuotationItem[]
  driverPayoutItems      DriverPayoutItem[]
  dhcReferenceItems      DhcReferenceItem[]

  @@index([tenantId, customerCompanyId, type, isActive])
  @@index([tenantId, type, uploadedAt])
  @@map("master_files")
}

model CustomerQuotationItem {
  id           String   @id @default(cuid())
  tenantId     String
  masterFileId String
  section      String?
  code         String
  label        String
  description  String?
  category     String?
  containerSize String?
  tripMode     String?
  areaScope    String?
  unit         String?
  rateCents    Int
  notes        String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterFile MasterFile @relation(fields: [masterFileId], references: [id], onDelete: Cascade)

  @@index([tenantId, masterFileId])
  @@index([tenantId, active, code])
  @@map("customer_quotation_items")
}

model DriverPayoutItem {
  id                      String   @id @default(cuid())
  tenantId                String
  masterFileId            String
  section                 String?
  code                    String
  label                   String
  description             String?
  category                String?
  containerSize           String?
  tripMode                String?
  areaScope               String?
  unit                    String?
  rateCents               Int
  notes                   String?
  isSelectableForTripEarning Boolean @default(true)
  sortOrder               Int      @default(0)
  active                  Boolean  @default(true)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterFile MasterFile @relation(fields: [masterFileId], references: [id], onDelete: Cascade)
  trips      Trip[]

  @@index([tenantId, masterFileId])
  @@index([tenantId, active, code])
  @@map("driver_payout_items")
}

model DhcReferenceItem {
  id           String   @id @default(cuid())
  tenantId     String
  masterFileId String
  section      String?
  code         String
  label        String
  description  String?
  category     String?
  unit         String?
  rateCents    Int?
  notes        String?
  sortOrder    Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  masterFile MasterFile @relation(fields: [masterFileId], references: [id], onDelete: Cascade)

  @@index([tenantId, masterFileId])
  @@index([tenantId, active, code])
  @@map("dhc_reference_items")
}

model Vehicle {
  id                 String        @id @default(cuid())
  tenantId           String
  plateNo            String
  type               VehicleType
  status             VehicleStatus @default(ACTIVE)
  vehicleDescription String?
  driverId           String?
  roadTaxExpiryDate  DateTime?
  lastServicingDate  DateTime?
  coeExpiryDate      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  trips              Trip[]
  tenant             Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driversDefault     drivers[]
  driver             User?         @relation("VehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)

  @@unique([tenantId, plateNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, driverId])
  @@map("vehicles")
}

model FleetVehicle {
  id                 String        @id @default(cuid())
  tenantId           String
  plateNo            String
  type               VehicleType
  status             VehicleStatus @default(ACTIVE)
  vehicleDescription String?
  driverId           String?
  roadTaxExpiryDate  DateTime?
  lastServicingDate  DateTime?
  coeExpiryDate      DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  driver         User?    @relation("FleetVehicleDriver", fields: [driverId], references: [id], onDelete: SetNull)
  driversDefault drivers[]
  jobsAssigned   Job[]
  trips          Trip[]

  @@unique([tenantId, plateNo])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type])
  @@index([tenantId, driverId])
  @@map("fleet_vehicles")
}

model Stop {
  id                         String                    @id @default(cuid())
  tenantId                   String
  tripId                     String?
  sequence                   Int?
  type                       StopType
  addressLine1               String
  addressLine2               String?
  city                       String
  postalCode                 String
  country                    String
  plannedAt                  DateTime?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime                  @updatedAt
  transportOrderId           String?
  completedAt                DateTime?
  startedAt                  DateTime?
  status                     StopStatus                @default(Pending)
  driver_wallet_transactions DriverWalletTransaction[]
  podPhotoDocuments          PodPhotoDocument[]
  pods                       Pod[]
  inventory_units            inventory_units[]
  tenant                     Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transportOrder             TransportOrder?           @relation("OrderStops", fields: [transportOrderId], references: [id])
  trip                       Trip?                     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  lat                        Float?
  lng                        Float?
  placeId                    String?
  geocodedAt                 DateTime?

  @@index([tenantId, transportOrderId])
  @@index([tenantId, tripId])
  @@map("stops")
}

model Pod {
  id        String    @id @default(cuid())
  tenantId  String
  stopId    String
  status    PodStatus @default(Pending)
  signedBy  String?
  signedAt  DateTime?
  photoUrl  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  photoKeys Json?
  stop      Stop      @relation(fields: [stopId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stopId])
  @@index([tenantId, status])
  @@map("pods")
}

model PodPhotoDocument {
  id        String   @id @default(cuid())
  tenantId  String
  stopId    String
  photoKey  String
  createdAt DateTime @default(now())
  stop      Stop     @relation(fields: [stopId], references: [id], onDelete: Cascade)
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, stopId])
  @@map("pod_photo_documents")
}

model DriverWalletTransaction {
  id               String          @id @default(cuid())
  tenantId         String
  tripId           String?
  amountCents      Int
  currency         String          @default("SGD")
  type             String
  description      String?
  createdAt        DateTime        @default(now())
  driverId         String
  stopId           String?
  transportOrderId String?
  drivers          drivers         @relation(fields: [driverId], references: [id], onDelete: Cascade)
  stops            Stop?           @relation(fields: [stopId], references: [id])
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  transport_orders TransportOrder? @relation(fields: [transportOrderId], references: [id])
  trip             Trip?           @relation(fields: [tripId], references: [id])

  @@unique([tripId, transportOrderId])
  @@index([stopId])
  @@index([tenantId, driverId])
  @@map("driver_wallet_transactions")
}

model EventLog {
  id         String   @id @default(cuid())
  tenantId   String
  entityType String
  entityId   String
  eventType  String
  payload    Json?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("event_logs")
}

model DriverLocationLatest {
  id           String   @id @default(cuid())
  tenantId     String
  driverUserId String
  lat          Float
  lng          Float
  accuracy     Float?
  heading      Float?
  speed        Float?
  capturedAt   DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, driverUserId])
  @@index([tenantId, updatedAt])
  @@map("driver_location_latest")
}

model driver_wallet_entries {
  id          String   @id
  tenantId    String
  driverId    String
  amountCents Int
  currency    String   @default("SGD")
  sourceType  String
  sourceId    String
  createdAt   DateTime @default(now())
  drivers     drivers  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  tenants     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([driverId, createdAt])
  @@index([tenantId, driverId])
}

model drivers {
  id                         String                    @id
  tenantId                   String
  email                      String
  name                       String
  phone                      String
  assignedVehicleId           String?
  assignedFleetVehicleId      String?
  createdAt                  DateTime                  @default(now())
  updatedAt                  DateTime
  userId                     String?
  driver_wallet_entries      driver_wallet_entries[]
  driver_wallet_transactions DriverWalletTransaction[]
  tenants                    Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                      User?                     @relation(fields: [userId], references: [id])
  trips                      Trip[]
  assignedVehicle             Vehicle?                  @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)
  assignedFleetVehicle        FleetVehicle?             @relation(fields: [assignedFleetVehicleId], references: [id], onDelete: SetNull)

  @@unique([tenantId, email])
  @@unique([tenantId, userId])
  @@index([tenantId])
  @@index([tenantId, assignedVehicleId])
  @@index([tenantId, assignedFleetVehicleId])
}

model Job {
  id                 String    @id @default(cuid())
  tenantId           String
  customerCompanyId  String
  internalRef        String
  externalRef        String?
  jobType            JobType
  status             JobStatus @default(Draft)
  notes              String?
  pickupDate         DateTime?
  pickupAddress1     String
  pickupAddress2     String?
  pickupPostal       String?
  pickupContactName  String?
  pickupContactPhone String?
  deliveryAddress1   String
  deliveryAddress2   String?
  deliveryPostal     String?
  receiverName       String
  receiverPhone      String
  assignedDriverId   String?
  assignedVehicleId  String?
  assignedFleetVehicleId String?
  assignedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  deliveredAt        DateTime?
  podRecipientName   String?
  cancelledReason    String?
  cancelledAt        DateTime?
  cancelledByUserId  String?
  lastLat            Float?
  lastLng            Float?
  lastLocationAt     DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  createdByUserId String?
  /// IMPORT: Singapore port master code (master_singapore_ports.code)
  pickupPortCode  String?
  portTerminalCode String?
  portName         String?
  psaStorageRentLastDay DateTime?
  vesselName       String?
  vesselEta        DateTime?
  portnetReady     Boolean  @default(false)
  permitReady      Boolean  @default(false)
  returningDepotCode   String?
  returnLastDay        DateTime?
  /// EXPORT: origin depot and destination port codes (master data)
  exportOriginDepotCode String?
  exportPortCode        String?

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies @relation("JobCustomerCompany", fields: [customerCompanyId], references: [id], onDelete: Restrict)
  assignedDriver  User?              @relation("JobAssignedDriver", fields: [assignedDriverId], references: [id], onDelete: SetNull)
  assignedFleetVehicle FleetVehicle? @relation(fields: [assignedFleetVehicleId], references: [id], onDelete: SetNull)
  createdBy       User?              @relation("JobCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents       JobDocument[]
  items           JobItem[]
  trips           Trip[]
  charges         JobCharge[]

  @@unique([tenantId, internalRef])
  @@index([tenantId, customerCompanyId])
  @@index([tenantId, status])
  @@index([tenantId, pickupDate])
  @@index([tenantId, assignedDriverId])
  @@index([tenantId, assignedFleetVehicleId])
  @@index([tenantId, createdByUserId])
  @@map("jobs")
}

model JobItem {
  id       String @id @default(cuid())
  tenantId String
  jobId    String

  itemCode    String
  description String?
  qty         Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@index([tenantId, itemCode])
  @@map("job_items")
}

model JobDocument {
  id               String          @id @default(cuid())
  tenantId         String
  jobId            String
  type             JobDocumentType
  storageKey       String
  originalName     String
  mimeType         String
  sizeBytes        Int?
  uploadedByUserId String?
  createdAt        DateTime        @default(now())

  job    Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, jobId])
  @@index([tenantId, type])
  @@map("job_documents")
}

/// Company-level quotation file versions (Supabase storage). One ACTIVE per company at a time.
model CustomerCompanyQuotation {
  id                String                 @id @default(cuid())
  tenantId          String
  customerCompanyId String
  storageKey        String
  originalName      String
  mimeType          String
  sizeBytes         Int?
  uploadedByUserId  String?
  effectiveDate     DateTime?
  status            QuotationVersionStatus @default(ACTIVE)
  parsedSummaryJson Json?
  createdAt         DateTime               @default(now())

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies @relation(fields: [customerCompanyId], references: [id], onDelete: Cascade)
  uploadedBy      User?              @relation("QuotationUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  rateLines       CustomerQuotationRateLine[]
  masterRateLines CustomerRateMasterLine[]

  @@index([tenantId, customerCompanyId])
  @@index([tenantId, customerCompanyId, status])
  @@map("customer_company_quotations")
}

model CustomerQuotationRateLine {
  id           String   @id @default(cuid())
  tenantId     String
  quotationId  String
  section      String?
  code         String
  label        String
  description  String?
  unit         String?
  rateCents    Int
  containerSize String?
  tripMode     String?
  areaScope    String?
  sortOrder    Int      @default(0)
  /// PARSER_ANNEX | MANUAL | SEED
  sourceType   String   @default("PARSER_ANNEX")
  createdAt    DateTime @default(now())

  tenant    Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  quotation CustomerCompanyQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([tenantId, quotationId])
  @@index([tenantId, code])
  @@map("customer_quotation_rate_lines")
}

/// Canonical structured rate master (Excel-controlled) used for job charge/rate selection.
model CustomerRateMasterLine {
  id            String   @id @default(cuid())
  tenantId      String
  customerCompanyId String
  sourceQuotationId String?
  section       String?
  code          String
  label         String
  description   String?
  category      String?
  containerSize String?
  tripMode      String?
  areaScope     String?
  unit          String?
  rateCents     Int
  notes         String?
  isSelectableForJob         Boolean @default(true)
  isSelectableForTripEarning Boolean @default(false)
  active        Boolean  @default(true)
  sortOrder     Int      @default(0)
  sourceType    String   @default("EXCEL_MASTER")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant          Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerCompany customer_companies @relation(fields: [customerCompanyId], references: [id], onDelete: Cascade)
  sourceQuotation CustomerCompanyQuotation? @relation(fields: [sourceQuotationId], references: [id], onDelete: SetNull)

  @@index([tenantId, customerCompanyId, active])
  @@index([tenantId, customerCompanyId, code])
  @@map("customer_rate_master_lines")
}

/// Frozen billable lines selected for a job (never updated from live quotation/master).
model JobCharge {
  id                String             @id @default(cuid())
  tenantId          String
  jobId             String
  sourceType        JobChargeSourceType
  sourceRefId       String?
  sourceCustomerQuotationItemId String?
  code              String
  label             String
  description       String?
  qty               Int                @default(1)
  unitPriceCents    Int
  amountCents       Int
  currency          String             @default("SGD")
  taxable           Boolean            @default(true)
  taxCode           String?
  taxRateBasisPoints Int?
  sortOrder         Int                @default(0)
  selectedByUserId  String?
  overrideReason    String?
  metadataJson      Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  tenant       Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job          Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  selectedBy   User?  @relation("JobChargeSelectedBy", fields: [selectedByUserId], references: [id], onDelete: SetNull)

  @@index([tenantId, jobId])
  @@index([tenantId, sourceCustomerQuotationItemId])
  @@map("job_charges")
}

/// Tenant-scoped DHC / depot handling lookup rows for charge selection (snapshots go to JobCharge).
model DepotHandlingReference {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  label        String
  amountCents  Int?
  currency     String   @default("SGD")
  active       Boolean  @default(true)
  metadataJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("depot_handling_references")
}

/// Trucking rate master copy (per tenant). Trip stores snapshot on assignment.
model DriverTripRateMaster {
  id           String   @id @default(cuid())
  tenantId     String
  code         String
  label        String
  amountCents  Int
  currency     String   @default("SGD")
  active       Boolean  @default(true)
  metadataJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trips  Trip[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
  @@map("driver_trip_rate_masters")
}

model TripDocument {
  id               String           @id @default(cuid())
  tenantId         String
  tripId           String
  type             TripDocumentType
  storageKey       String
  originalName     String
  mimeType         String
  sizeBytes        Int?
  uploadedByUserId String?
  createdAt        DateTime         @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tenantId, tripId])
  @@index([tenantId, type])
  @@map("trip_documents")
}

/// Global Singapore ports list (not tenant-scoped; extend via migrations or admin later).
model MasterSingaporePort {
  id   String @id @default(cuid())
  code String @unique
  name String

  @@map("master_singapore_ports")
}

model MasterSingaporeDepot {
  id   String @id @default(cuid())
  code String @unique
  name String

  @@map("master_singapore_depots")
}

/// Controlled list: 7 Gul Circle trailer last-known locations (extend later).
model MasterTrailerLocation {
  id   String @id @default(cuid())
  code String @unique
  name String

  @@map("master_trailer_locations")
}

model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  actorUserId String?
  entityType  String
  entityId    String
  action      String
  metadata    Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, entityType, entityId])
  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model job_internal_ref_counters {
  tenantId  String
  yyyymm    String
  nextSeq   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@id([tenantId, yyyymm])
  @@index([tenantId])
  @@map("job_internal_ref_counters")
}

model inventory_items {
  id                    String                  @id
  tenantId              String
  sku                   String
  name                  String
  reference             String?
  availableQty          Int                     @default(0)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  tenants               Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventory_units       inventory_units[]
  inventory_batch_items inventory_batch_items[]
  transport_order_items transport_order_items[]

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model profiles {
  id         String   @id
  userId     String   @unique
  globalRole String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  users      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

